#!/usr/bin/env node
'use strict';

// ======== HEADER ========
// Simple Agentic Stub - One-file agent runner with tool calling
// Purpose: Minimal scaffold for AI to fill in tool implementations
// Usage:
//   node agent.js "Your task here"
//   node agent.js "Your task" --yolo              # Auto-execute tools
//   node agent.js "Your task" --model mistral-small # Choose Ollama model
//   node agent.js "Your task" --cwd ./workspace   # Set working dir
//
// Environment Variables:
//   OLLAMA_HOST      - Default: http://localhost:11434
//   Default: Ollama (local, no keys). Cloud providers available via --provider flag.

// ======== CONFIGURATION ========
const CONFIG = {
  logLevel: process.env.LOG_LEVEL || 'info',
  maxTurns: 5,
  toolTimeoutMs: 30_000,
  maxToolOutputChars: 4096, // Prevent context explosion from large outputs
  maxLLMOutputTokens: 4096, // Max tokens for LLM responses (applies to providers that require it)
  maxDownloadBytes: 50 * 1024 * 1024, // 50MB limit for download_file
  maxSpawnDepth: 3, // Max nesting depth for spawn_agent (prevent infinite recursion)
  spawnMaxTurns: 3, // Default turn limit for spawned subagents (keep them focused)
  // Default task — AI should set this when the agent has a specific purpose.
  // If set, users can run `node agent.js --yolo` without a task argument.
  // Users can still override: `node agent.js "custom task" --yolo`
  defaultTask: '',
  // Skill registry — workspace-relative dir scanned for SKILL.md bundles (Anthropic-style skills).
  // Each ./<skillsDir>/<name>/SKILL.md with YAML frontmatter {name, description} becomes a skill
  // the agent can discover (list_skills) and open on demand (load_skill). Progressive disclosure:
  // only name+description load at turn 1; the body loads only when the agent opens a skill.
  skillsDir: 'skills',
  // Network allowlist — hosts the HTTP tools are permitted to fetch from.
  // Each entry is a bare host (`example.com`) or a wildcard subdomain (`*.example.com`).
  // Empty array = allow all (permissive; intentional for backward compatibility).
  // Extend at runtime with --allow-host <host> (repeatable) or AGENT_BUILDER_ALLOW_HOSTS
  // (comma-separated env var). See AGENTS.md for domains commonly added per-agent type.
  networkAllowlist: [
    'duckduckgo.com',
    'html.duckduckgo.com',
  ],
  // MCP (Model Context Protocol) servers. Each entry is `{ command, args?, env? }`; the
  // harness spawns the server as a child process at startup and exposes each of its tools
  // as `<serverKey>_<toolName>`. Leave empty to auto-load from ./mcp.json in the cwd if
  // present. See AGENTS.md for examples (filesystem, github, slack, etc.).
  mcpServers: {},
  // Timeouts for MCP operations (ms). Handshake should be quick; tool calls can be longer.
  mcpConnectTimeoutMs: 15_000,
  mcpCallTimeoutMs: 60_000,
};

// Small helpers to render tool lists for instructions
function toolListInline() {
  return Object.keys(ToolRegistry).join(', ');
}

function toolBullets() {
  return Object.keys(ToolRegistry)
    .map(n => `- **${n}** — ${TOOL_DOCS[n] || 'See help'}`)
    .join('\n');
}

// ======== UTILITIES ========
const fs = require('fs');
const path = require('path');
const vm = require('vm');
const readline = require('readline');
const { execFileSync, spawn } = require('child_process');

const LOG_LEVELS = { debug: 0, info: 1, warn: 2, error: 3 };
const level = LOG_LEVELS[CONFIG.logLevel] ?? LOG_LEVELS.info;
const logger = {
  debug: (...a) => level <= 0 && console.error('[DEBUG]', ...a),
  info: (...a) => level <= 1 && console.log('[INFO]', ...a),
  warn: (...a) => level <= 2 && console.warn('[WARN]', ...a),
  error: (...a) => level <= 3 && console.error('[ERROR]', ...a),
};

class AppError extends Error {
  constructor(message, code = 'ERROR', exitCode = 2) {
    super(message);
    this.name = 'AppError';
    this.code = code;
    this.exitCode = exitCode;
  }
}

// Helper to validate required string parameters
function assertString(value, name) {
  if (typeof value !== 'string' || !value.trim()) {
    throw new AppError(`${name} must be a non-empty string`, 'VALIDATION');
  }
  return value.trim();
}

// --- Minimal .env loader (no deps) ---
function loadDotEnvToProcess(cwd) {
  try {
    const envPath = path.join(cwd, '.env');
    if (!fs.existsSync(envPath)) return;
    const lines = fs.readFileSync(envPath, 'utf8').split(/\r?\n/);
    for (const line of lines) {
      const m = line.match(/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)\s*$/);
      if (!m) continue;
      const key = m[1];
      let val = m[2];
      if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
        val = val.slice(1, -1);
      }
      if (!(key in process.env)) process.env[key] = val;
    }
  } catch (e) {
    logger.warn('Failed to load .env:', e.message);
  }
}

// --- Hidden input prompt (TTY only) ---
function promptHidden(query) {
  return new Promise((resolve) => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    const onData = (char) => {
      char = String(char);
      // redraw with asterisks
      if (char === '\n' || char === '\r' || char === '\u0004') {
        process.stdout.write('\n');
        rl.input.removeListener('data', onData);
      } else {
        const len = rl.line.length;
        process.stdout.clearLine(0);
        process.stdout.cursorTo(0);
        process.stdout.write(query + '*'.repeat(len));
      }
    };
    rl.question(query, (value) => {
      rl.history = rl.history.slice(1);
      rl.close();
      resolve(value.trim());
    });
    rl.input.on('data', onData);
  });
}

// --- Ensure API key with CLI/env/.env/prompt fallback ---
async function ensureApiKey({ envName, cliValue, promptLabel, cwd, saveToEnv = false }) {
  let key = (cliValue || process.env[envName] || '').trim();
  if (!key) {
    loadDotEnvToProcess(cwd);
    key = (process.env[envName] || '').trim();
  }
  if (!key) {
    if (!(process.stdin.isTTY && process.stdout.isTTY)) {
      throw new AppError(`${envName} not set and no TTY to prompt. Set ${envName} or pass a --${envName.toLowerCase().replace(/_api_/, '-')} flag.`, 'CONFIG');
    }
    key = await promptHidden(`${promptLabel} (input hidden): `);
    if (!key) throw new AppError(`${envName} is required`, 'CONFIG');
    if (saveToEnv) {
      const envPath = path.join(cwd, '.env');
      fs.appendFileSync(envPath, `\n${envName}=${key}\n`);
      logger.info(`Saved ${envName} to .env (workspace-local)`);
    }
    process.env[envName] = key;
  }
  return key;
}

// Helper to ensure file paths don't escape working directory
function safePath(baseDir, targetPath) {
  const base = path.resolve(baseDir);
  const resolved = path.resolve(base, String(targetPath || ''));
  const rel = path.relative(base, resolved);
  if (rel === '' || rel === '.') return resolved;
  if (rel.startsWith('..') || path.isAbsolute(rel)) {
    throw new AppError(`Path escapes working directory: ${targetPath}`, 'SECURITY');
  }
  return resolved;
}

// Truncate long outputs to avoid context explosion
// hint: optional suggestion shown to the model when output is truncated
// Enforce CONFIG.networkAllowlist on URLs passed to HTTP tools. Empty allowlist = allow all.
// Throws an AppError with SECURITY code when blocked, pointing at the unblock flag.
function checkUrlAllowed(url) {
  if (!CONFIG.networkAllowlist.length) return;
  let host;
  try { host = new URL(url).hostname; }
  catch { throw new AppError(`Invalid URL: ${url}`, 'VALIDATION'); }
  for (const entry of CONFIG.networkAllowlist) {
    if (entry.startsWith('*.')) {
      const suffix = entry.slice(2);
      if (host === suffix || host.endsWith('.' + suffix)) return;
    } else if (host === entry) {
      return;
    }
  }
  throw new AppError(
    `Network access blocked: ${host} is not in the allowlist (${CONFIG.networkAllowlist.join(', ')}). ` +
    `Add it with --allow-host ${host} or set AGENT_BUILDER_ALLOW_HOSTS.`,
    'SECURITY'
  );
}

function truncate(text, maxChars = CONFIG.maxToolOutputChars, hint = '') {
  const str = String(text || '');
  if (str.length > maxChars) {
    const suffix = hint
      ? `\n...[truncated ${str.length - maxChars} chars. ${hint}]`
      : `\n...[truncated ${str.length - maxChars} chars]`;
    return str.slice(0, maxChars) + suffix;
  }
  return str;
}

// Simple YAML frontmatter parser (no deps)
// Returns { meta: { key: value, ... }, body: "content after frontmatter" }
function parseFrontmatter(text) {
  const str = String(text || '');
  const match = str.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
  if (!match) return { meta: {}, body: str };
  const meta = {};
  for (const line of match[1].split(/\r?\n/)) {
    const m = line.match(/^(\w[\w-]*)\s*:\s*(.*)$/);
    if (!m) continue;
    let val = m[2].trim();
    // Parse arrays: [a, b, c]
    if (val.startsWith('[') && val.endsWith(']')) {
      val = val.slice(1, -1).split(',').map(s => s.trim()).filter(Boolean);
    } else if (val === 'true') val = true;
    else if (val === 'false') val = false;
    else if (/^\d+$/.test(val)) val = Number(val);
    meta[m[1]] = val;
  }
  return { meta, body: match[2] };
}

// Path to the standard well-known skills index (RFC 8615 + agentskills.io v0.2.0).
const WELL_KNOWN_SKILLS_PATH = '/.well-known/agent-skills/index.json';

// Subdir under CONFIG.skillsDir where extract_skill writes drafts. Visible (no leading dot) so
// non-technical users can browse ./skills/drafts/ in Finder or a plain `ls`, but excluded from
// discoverLocalSkills so drafts do not pollute the turn-1 system prompt until promoted.
const SKILL_DRAFTS_DIRNAME = 'drafts';

// Scan ./<skillsDir>/*/SKILL.md and return {name, description, dir} entries.
// Safe to call when the directory is missing — returns [].
function discoverLocalSkills(cwd) {
  const root = path.join(cwd, CONFIG.skillsDir);
  let entries;
  try { entries = fs.readdirSync(root, { withFileTypes: true }); }
  catch { return []; }

  const skills = [];
  for (const entry of entries) {
    if (!entry.isDirectory() || entry.name.startsWith('.') || entry.name === SKILL_DRAFTS_DIRNAME) continue;
    const skillPath = path.join(root, entry.name, 'SKILL.md');
    let raw;
    try { raw = fs.readFileSync(skillPath, 'utf8'); }
    catch { continue; }
    const { meta } = parseFrontmatter(raw);
    const name = typeof meta.name === 'string' ? meta.name : entry.name;
    const description = typeof meta.description === 'string' ? meta.description : '';
    if (!description) continue; // skill must have a description to be discoverable
    skills.push({ name, description, dir: entry.name });
  }
  return skills;
}

// Render the Level-1 preview appended to the turn-1 system prompt.
// Keeps each line short so ~20 skills still fits comfortably in a local model's context.
function formatSkillsForPrompt(skills) {
  if (!skills.length) return '';
  const lines = skills.map(s => `- ${s.name}: ${s.description}`);
  return [
    '',
    'Available skills (call load_skill with the name to open one before acting on its domain):',
    ...lines,
  ].join('\n');
}

// Convert title to kebab-case filename slug
function toSlug(title) {
  return String(title || '')
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/[\s_]+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 80) || 'untitled';
}

// Tolerant JSON parser for LLM-generated output
// Handles common LLM mistakes like trailing commas, single quotes, unquoted keys
function tryParseJSON(s) {
  // First try strict parsing
  try { return JSON.parse(s); } catch { }

  // Process string character by character, tracking string state
  let out = '';
  let inStr = false, esc = false;

  for (let i = 0; i < s.length; i++) {
    const ch = s[i];

    if (inStr) {
      // Inside a string - preserve everything except handle escapes
      if (esc) {
        esc = false;
        out += ch;
        continue;
      }
      if (ch === '\\') {
        esc = true;
        out += ch;
        continue;
      }
      if (ch === '"') {
        inStr = false;
        out += ch;
        continue;
      }
      out += ch;
    } else {
      // Outside strings - apply fixes
      if (ch === '"') {
        inStr = true;
        out += ch;
      } else if (ch === "'") {
        // Replace single quotes with double quotes (for string delimiters)
        out += '"';
      } else if (ch === ',' && i + 1 < s.length) {
        // Check if this comma is followed by } or ] (trailing comma)
        let j = i + 1;
        while (j < s.length && /\s/.test(s[j])) j++;
        if (j < s.length && (s[j] === '}' || s[j] === ']')) {
          // Skip trailing comma
          continue;
        }
        out += ch;
      } else {
        out += ch;
      }
    }
  }

  // Quote unquoted keys at object boundaries only
  let relaxed = out.replace(/([{,]\s*)([A-Za-z_][A-Za-z0-9_]*)\s*:/g, '$1"$2":');

  try {
    return JSON.parse(relaxed);
  } catch (e) {
    // If still fails, throw original error for debugging
    throw new Error(`Invalid JSON: ${e.message}`);
  }
}

// ======== TOOL REGISTRY ========
// --- Tool docs used for quick help (optional but helpful) ---
const TOOL_DOCS = {
  help: 'Get tool documentation. args: {tool?}',
  list_files: 'List files in workspace. args: {path=".", pattern?}',
  read_file: 'Read text file. args: {path, max_bytes?=4096, start_line?, end_line?, with_line_numbers?=false} — when start_line is set, returns a 100-line window with numbered lines (use before patch_file)',
  write_file: 'Write text file. args: {path, content}',
  patch_file: 'Surgical line-range edit. args: {path, start_line, end_line, replacement} — replaces lines start_line..end_line inclusive; pass empty replacement to delete. Read with start_line first to verify line numbers.',
  fetch_url: 'HTTP(S) fetch. args: {url, method?, headers?, body?, as?=text|json, max_bytes?=4096}',
  define_tool: 'Define a new tool at runtime. args: {name, code}',
  search_web: 'DuckDuckGo HTML search. args: {query, max_results?}',
  scrape_page: 'Fetch & strip HTML to clean text. args: {url, max_bytes?=4096}',
  download_file: 'Download URL to workspace. args: {url, path}',
  delete_file: 'Delete a workspace file. args: {path}',
  ingest_source: 'Ingest content into knowledge base. args: {title, content, source?="user", tags?=[], type?="article"}',
  read_manifest: 'Read knowledge base manifest. args: {filter?="all"} (filter: "all"|"uncompiled"|"compiled")',
  mark_compiled: 'Mark a raw source as compiled. args: {file}',
  search_context: 'Search knowledge base files by content. args: {query, path?="context", max_results?=10} — uses rg/grep when available',
  save_learning: 'Save an operational learning. args: {content, category?="discovery"}',
  read_section: 'Read a markdown file by heading. args: {path, heading?} — omit heading to list all headings',
  finish_task: 'Declare the task complete and return a final summary. args: {summary, files_created?}',
  spawn_agent: 'Spawn a focused subagent with its own context. args: {task, instruction?, max_turns?=3} — use for subtasks that would fill context (research, analysis, code generation)',
  list_skills: 'List local SKILL.md bundles (name + description). args: {} — cheap Level-1 preview; use before load_skill',
  load_skill: 'Open one skill: return the full SKILL.md body so you can follow it. args: {name} — relative links in the body resolve under ./skills/<name>/',
  discover_skills: 'List skills published at a remote /.well-known/agent-skills/index.json. args: {url} — read-only; install via `npx skills add` or add-skill.sh',
  extract_skill: 'Capture a methodology as a reusable SKILL.md draft. args: {name, description, when_to_use, steps[{title,actions,success_criteria,artifacts?,rules?}], goal?, inputs?, rules?} — writes ./skills/drafts/<name>/SKILL.md; promote with `mv skills/drafts/<name> skills/<name>`',
  run_in_container: 'Run a shell command inside an isolated OCI container (Apple `container` CLI or Docker). args: {image, command, mounts?=[], workdir?, network?="none", timeout_ms?=30000} — default is no network + no host writes; load the apple-container skill for install/setup',
  describe_mcp_tool: 'Return full JSONSchema + description for a connected MCP tool. args: {name} — only needed when the Level-1 signature in the system prompt is insufficient'
};

// Error recovery hints keyed by common error codes.
// Gives the model actionable next steps instead of raw errors.
const RECOVERY_HINTS = {
  ENOENT: 'File not found. Use list_files to check what exists.',
  EACCES: 'Permission denied. Check file permissions or try a different path.',
  ECONNREFUSED: 'Connection refused. Is the target service running?',
  ETIMEDOUT: 'Connection timed out. Try again or use a different URL.',
  SECURITY: 'Path is outside the workspace. Use relative paths within --cwd.',
  VALIDATION: 'Missing or invalid argument. Check the tool signature with help.',
  TOOL_ERROR: '',
  ABORTED: 'Tool timed out. Simplify the request or try a smaller input.',
};

function formatError(toolName, error) {
  const code = error.code || '';
  const hint = RECOVERY_HINTS[code] || '';
  const msg = error.message || 'Tool execution failed';
  return hint
    ? `[FAIL] ${toolName}: ${msg}\n  Hint: ${hint}`
    : `[FAIL] ${toolName}: ${msg}`;
}
/*
AI INSTRUCTIONS FOR IMPLEMENTING TOOLS:

1. TOOL NAMING:
   - Use snake_case (e.g., fetch_data, write_report)
   - Be specific about what the tool does
   - Avoid generic names like 'process' or 'handle'

2. TOOL STRUCTURE:
   - Each tool is an async function: async tool_name(args, ctx)
   - Parameters:
     * args: Object containing tool arguments from the LLM
     * ctx: Context object with { cwd: working_directory, signal: abort_signal }
   - Return: String with the result (keep it under 2KB for context efficiency)
   - Errors: Throw AppError with helpful messages

3. TOOL IMPLEMENTATION GUIDELINES:
   - Validate all required parameters at the start
   - Use try-catch for external operations
   - Keep outputs concise but informative
   - Include relevant details the LLM needs to continue
   - For file operations, use ctx.cwd as the base directory
   - For long operations, check ctx.signal.aborted periodically
   - Return structured information when possible (lists, key points)

4. WHEN LLM SHOULD CALL TOOLS:
   - Make tool descriptions clear about WHEN to use them
   - Include what inputs are expected
   - Describe what the tool returns
   - Tools are called with syntax: <<tool:name {"param":"value"}>>

5. EXAMPLE TOOL CATEGORIES TO IMPLEMENT:
   - File Operations: read_file, write_file, list_files, search_files
   - Web Operations: fetch_url, search_web, scrape_page
   - Data Processing: analyze_data, extract_info, summarize_text
   - Code Operations: execute_code, analyze_code, generate_code
   - Communication: send_email, post_message, notify_user
   - Domain Specific: Your agent's specialized tools
*/

const ToolRegistry = {
  // Dynamic tool signature helper
  async help(args, ctx) {
    const { tool } = args || {};
    const names = Object.keys(ToolRegistry).sort();

    // List mode
    if (!tool) {
      return [
        'Tools:',
        names.join(', '),
        '',
        'Usage:',
        '  <<tool:help {"tool":"TOOL_NAME"}>>',
        '',
        'Tip: Ask for a tool then copy the example payload from the output.'
      ].join('\n');
    }

    const fn = ToolRegistry[tool];
    if (!fn) return `Unknown tool: ${tool}\nAvailable: ${names.join(', ')}`;

    const src = fn.toString();

    // Try to capture a short signature line (method or arrow)
    const sig =
      (src.match(/async\s+\w+\s*\([^)]*\)/)?.[0]) ||          // async tool(args, ctx)
      (src.match(/async\s*\(\s*[^)]*\s*\)\s*=>/)?.[0]) ||     // async (args, ctx) =>
      (src.match(/\bfunction\s+\w+\s*\([^)]*\)/)?.[0]) ||     // function tool(args, ctx)
      `${tool}(args, ctx)`;

    // Heuristic: extract destructured args to suggest param keys/defaults
    // Looks for: const { a, b = 1, c: alias = 'x' } = args || {};
    const d = src.match(/const\s*{\s*([^}]*)\s*}\s*=\s*args\s*\|\|\s*{}/);
    let kvPairs = [];
    if (d && d[1]) {
      kvPairs = d[1]
        .split(',')
        .map(s => s.trim())
        .filter(Boolean)
        .map(p => {
          // Normalize "key: alias = default" | "key = default" | "key"
          const [left, defPart] = p.split('=').map(s => s && s.trim());
          const key = (left.includes(':') ? left.split(':')[0] : left).trim();
          const def = (defPart || '').trim();
          // Produce a conservative placeholder; keep simple JSON (quote strings)
          let sample = '""';
          if (/^(true|false|null|\[|\{|\d)/i.test(def)) sample = def;    // keep obvious JSON
          else if (def) sample = `"${def.replace(/^['"]|['"]$/g, '')}"`;  // strip quotes if present
          return [key.replace(/\s+/g, ''), def ? sample : '""'];
        });
    }

    const examplePayload =
      kvPairs.length
        ? '{ ' + kvPairs.map(([k, v]) => `"${k}": ${v}`).join(', ') + ' }'
        : '{ }';

    return [
      `Tool: ${tool}`,
      `Signature: ${sig}`,
      kvPairs.length
        ? `Params (guessed): ${kvPairs.map(([k]) => k).join(', ')}`
        : 'Params: (args, ctx)',
      `Usage: <<tool:${tool} ${examplePayload}>>`
    ].join('\n');
  },

  // PLACEHOLDER TOOL - Replace this with your actual tools
  // This example shows the complete pattern for implementing a tool
  async example_tool(args, ctx) {
    // Step 1: Extract and validate parameters
    const {
      required_param,           // Required parameter
      optional_param = 'default' // Optional with default
    } = args || {};

    // Step 2: Validate required parameters
    assertString(required_param, 'required_param');

    // Step 3: Implement the tool logic
    try {
      // Example: Do some work here
      logger.debug(`Executing example_tool with param: ${required_param}`);

      // Check for cancellation in long operations
      if (ctx.signal?.aborted) {
        throw new AppError('Operation cancelled', 'ABORTED');
      }

      // Simulate some work
      const result = `Processed: ${required_param} with option: ${optional_param}`;

      // Step 4: Return concise, useful result (auto-truncated)
      return truncate(result);

    } catch (error) {
      // Step 5: Handle errors with helpful messages
      if (error instanceof AppError) throw error;
      throw new AppError(`Tool failed: ${error.message}`, 'TOOL_ERROR');
    }
  },

  // META-TOOL: Define new tools at runtime
  // This allows the AI to create tools it needs on the fly
  // WARNING: Dynamic tools have limited file access through the 'file' helper
  // which enforces workspace confinement. File operations are bound to ctx.cwd.
  // Usage in dynamic tools:
  //   await file.write('output.txt', 'content')
  //   const data = await file.read('input.txt', 1000)
  //   const files = await file.list('subdir')
  async define_tool(args, ctx) {
    const { name, code } = args || {};
    const toolName = assertString(name, 'name');
    assertString(code, 'code');
    if (!/^[a-zA-Z0-9_]{1,32}$/.test(toolName)) {
      throw new AppError('Tool name must be alphanumeric with underscores, max 32 chars', 'VALIDATION');
    }

    // Wrap user's code as an async function that receives (args, ctx)
    const wrappedSrc = `
      (async function ${toolName}(args, ctx) {
        ${code}
      })
    `;
    let compiled;
    try {
      const script = new vm.Script(wrappedSrc, { filename: `tool:${toolName}`, displayErrors: true });
      // Create sandbox with minimal file helper for opt-in file access
      const sandbox = vm.createContext({
        console, fetch, setTimeout, clearTimeout, URL, Buffer,
        AppError, assertString, truncate,  // allow helpers
        // file helper is injected per execution and always bound to toolCtx.cwd
        file: {} // will be (re)assigned with a baseDir-bound helper per invocation
      });
      compiled = script.runInContext(sandbox);
      if (typeof compiled !== 'function') throw new Error('Tool did not export a function');
    } catch (e) {
      throw new AppError(`Failed to compile tool '${toolName}': ${e.message}`, 'COMPILE_ERROR');
    }

    // Create a baseDir-bound file helper for each invocation
    const makeFileHelper = (baseDir) => Object.freeze({
      async write(relPath, contents) {
        const full = safePath(baseDir, relPath);
        fs.mkdirSync(path.dirname(full), { recursive: true });
        fs.writeFileSync(full, contents, 'utf8');
        return `OK:${relPath}`;
      },
      async read(relPath, maxBytes) {
        const full = safePath(baseDir, relPath);
        let data = fs.readFileSync(full, 'utf8');
        if (typeof maxBytes === 'number') data = data.slice(0, maxBytes);
        return data;
      },
      async list(relPath = '.') {
        const dir = safePath(baseDir, relPath);
        return fs.readdirSync(dir, { withFileTypes: true })
          .map(d => (d.isDirectory() ? d.name + '/' : d.name));
      }
    });

    ToolRegistry[toolName] = async (toolArgs, toolCtx) => {
      try {
        // Rebind a safe file helper for this run
        sandbox.file = makeFileHelper(toolCtx.cwd);
        const out = await compiled(toolArgs, toolCtx);
        return truncate(out);
      } catch (e) {
        throw new AppError(`Tool '${toolName}' failed: ${e.message}`, 'TOOL_ERROR');
      }
    };
    return `Tool '${toolName}' defined successfully`;
  },

  // --- Starter file tools ---
  async list_files(args, ctx) {
    const { path: p = '.', pattern } = args || {};
    const dir = safePath(ctx.cwd, p);
    const names = fs.readdirSync(dir, { withFileTypes: true })
      .map(d => (d.isDirectory() ? d.name + '/' : d.name));
    const filtered = pattern
      ? names.filter(n => {
        try { return new RegExp(pattern).test(n); } catch { return false; }
      })
      : names;
    return JSON.stringify(filtered, null, 2);
  },

  async read_file(args, ctx) {
    const { path: p, max_bytes, start_line, end_line, with_line_numbers } = args || {};
    assertString(p, 'path');
    const full = safePath(ctx.cwd, p);
    const raw = fs.readFileSync(full, 'utf8');

    // Line-windowed mode — when start_line is given, return exactly that range
    // (defaults to a 100-line window, the SWE-agent Goldilocks number). Line numbers
    // are 1-based and inclusive. Use this when the agent needs to target patch_file.
    if (typeof start_line === 'number' && start_line >= 1) {
      const lines = raw.split(/\r?\n/);
      // Drop the phantom empty trailing element that split leaves behind for files that
      // end in \n — so line counts match what patch_file expects.
      if (/\r?\n$/.test(raw) && lines[lines.length - 1] === '') lines.pop();
      const total = lines.length;
      const start = Math.max(1, Math.floor(start_line));
      const end = typeof end_line === 'number' && end_line >= start
        ? Math.min(total, Math.floor(end_line))
        : Math.min(total, start + 99);
      const slice = lines.slice(start - 1, end);
      const width = String(end).length;
      const body = with_line_numbers !== false
        ? slice.map((ln, i) => `${String(start + i).padStart(width)}: ${ln}`).join('\n')
        : slice.join('\n');
      const meta = `[lines ${start}-${end} of ${total}]`;
      return truncate(`${meta}\n${body}`, (typeof max_bytes === 'number' && max_bytes > 0) ? max_bytes : CONFIG.maxToolOutputChars * 2);
    }

    // Byte-mode (default) — whole file or byte-capped. Optionally prefix line numbers.
    const limit = (typeof max_bytes === 'number' && max_bytes > 0)
      ? max_bytes
      : CONFIG.maxToolOutputChars;
    let data = raw;
    if (with_line_numbers) {
      const lines = data.split(/\r?\n/);
      if (/\r?\n$/.test(data) && lines[lines.length - 1] === '') lines.pop();
      const width = String(lines.length).length;
      data = lines.map((ln, i) => `${String(i + 1).padStart(width)}: ${ln}`).join('\n');
    }
    if (data.length > limit) {
      const hint = `Pass max_bytes to read more, or set start_line/end_line for a windowed view, or use read_section to navigate by heading`;
      data = data.slice(0, limit) + `\n...[truncated ${data.length - limit} chars. ${hint}]`;
    }
    return data;
  },

  async write_file(args, ctx) {
    const { path: p, content = '' } = args || {};
    assertString(p, 'path');
    const full = safePath(ctx.cwd, p);
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, content, 'utf8');
    return `Wrote ${Buffer.byteLength(content, 'utf8')} bytes to ${p}`;
  },

  // patch_file replaces a line range (inclusive, 1-based) with `replacement`. Surgical edit
  // primitive — the SWE-agent paper showed line-range edits beat whole-file rewrites for any
  // code-editing agent because tokens scale with change size, not file size. Read the target
  // region with `read_file` + `start_line` first to verify line numbers before calling this.
  // No linter is wired in here (language-agnostic harness); compose with run_in_container or
  // a skill-provided checker if you need one. Preserves the file's trailing-newline style.
  async patch_file(args, ctx) {
    const { path: p, start_line, end_line, replacement = '' } = args || {};
    assertString(p, 'path');
    if (typeof start_line !== 'number' || start_line < 1) {
      throw new AppError('patch_file: start_line must be a 1-based integer', 'VALIDATION');
    }
    if (typeof end_line !== 'number' || end_line < start_line) {
      throw new AppError('patch_file: end_line must be >= start_line', 'VALIDATION');
    }
    const full = safePath(ctx.cwd, p);
    const raw = fs.readFileSync(full, 'utf8');
    const hadTrailingNewline = /\r?\n$/.test(raw);
    const lines = raw.split(/\r?\n/);
    // Drop the phantom empty string split produces when the file ends in a newline, so our
    // line indices match what `read_file start_line=` shows.
    if (hadTrailingNewline && lines[lines.length - 1] === '') lines.pop();
    const total = lines.length;
    if (start_line > total) {
      throw new AppError(`patch_file: start_line ${start_line} exceeds file length (${total})`, 'VALIDATION');
    }
    const clampedEnd = Math.min(end_line, total);
    const replacementLines = String(replacement).split(/\r?\n/);
    const removed = clampedEnd - start_line + 1;
    const added = (replacement === '' && removed > 0) ? 0 : replacementLines.length;
    const next = [
      ...lines.slice(0, start_line - 1),
      ...(replacement === '' && removed > 0 ? [] : replacementLines),
      ...lines.slice(clampedEnd),
    ];
    const out = next.join('\n') + (hadTrailingNewline ? '\n' : '');
    fs.writeFileSync(full, out, 'utf8');
    const delta = added - removed;
    const deltaStr = delta === 0 ? 'unchanged size' : (delta > 0 ? `+${delta} lines` : `${delta} lines`);
    return `Patched ${p}: replaced lines ${start_line}-${clampedEnd} (${removed} removed, ${added} added, ${deltaStr}). New length: ${next.length} lines.`;
  },

  // --- Minimal web tool ---
  async fetch_url(args, ctx) {
    const { url, method = 'GET', headers = {}, body, max_bytes, as = 'text' } = args || {};
    assertString(url, 'url');
    checkUrlAllowed(url);
    const res = await fetch(url, {
      method,
      headers: { 'User-Agent': 'agent-builder/1.0', ...(headers || {}) },
      body: body ? (typeof body === 'string' ? body : JSON.stringify(body)) : undefined,
      signal: ctx.signal
    });
    const raw = await res.text();
    let out = raw;
    if (as === 'json') {
      try { out = JSON.stringify(JSON.parse(raw), null, 2); } catch { }
    }
    const limit = (typeof max_bytes === 'number' && max_bytes > 0)
      ? max_bytes
      : CONFIG.maxToolOutputChars;
    const prefix = `Status: ${res.status}\n`;
    if (out.length + prefix.length > limit) {
      out = out.slice(0, limit - prefix.length) + `\n...[truncated. Pass max_bytes for larger response]`;
    }
    return prefix + out;
  },

  // Basic web search via DuckDuckGo HTML (no API key)
  async search_web(args, ctx) {
    const { query, max_results = 6 } = args || {};
    assertString(query, 'query');
    const q = encodeURIComponent(query);
    const url = `https://duckduckgo.com/html/?q=${q}`;
    const res = await fetch(url, { signal: ctx.signal, headers: { 'User-Agent': 'agent-builder/1.0' } });
    if (!res.ok) throw new AppError(`search_web failed: HTTP ${res.status}`, 'TOOL_ERROR');
    const html = await res.text();
    const items = [];
    const re = /<a[^>]+class=\"[^\"]*result__a[^\"]*\"[^>]+href=\"([^\"]+)\"[^>]*>(.*?)<\/a>/g;
    let m;
    while ((m = re.exec(html)) && items.length < Math.max(1, Math.min(20, max_results))) {
      const rawUrl = m[1];
      const title = m[2].replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
      // Skip DDG redirector when present
      let finalUrl = rawUrl;
      try {
        const u = rawUrl.startsWith('/l/?kh=') ? new URL('https://duckduckgo.com' + rawUrl) : new URL(rawUrl, 'https://duckduckgo.com');
        finalUrl = u.searchParams.get('uddg') || u.toString();
      } catch { }
      if (!/^https?:/i.test(finalUrl)) continue;
      items.push({ title, url: finalUrl });
    }
    return JSON.stringify(items, null, 2);
  },

  // Minimal page scraper that fetches and strips HTML to text
  async scrape_page(args, ctx) {
    const { url, max_bytes } = args || {};
    assertString(url, 'url');
    checkUrlAllowed(url);
    const res = await fetch(url, { signal: ctx.signal, headers: { 'User-Agent': 'agent-builder/1.0' } });
    const html = await res.text();
    const limit = (typeof max_bytes === 'number' && max_bytes > 0)
      ? max_bytes
      : CONFIG.maxToolOutputChars;
    const cleaned = html
      .replace(/<script[\s\S]*?<\/script>/gi, '')
      .replace(/<style[\s\S]*?<\/style>/gi, '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
    if (cleaned.length > limit) {
      return cleaned.slice(0, limit) + `\n...[truncated ${cleaned.length - limit} chars. Pass max_bytes for more content]`;
    }
    return cleaned;
  },

  // Download a URL to a safe path within the workspace
  async download_file(args, ctx) {
    const { url, path: p } = args || {};
    assertString(url, 'url');
    assertString(p, 'path');
    const full = safePath(ctx.cwd, p);
    checkUrlAllowed(url);
    const res = await fetch(url, { signal: ctx.signal, headers: { 'User-Agent': 'agent-builder/1.0' } });
    if (!res.ok) throw new AppError(`download_file failed: HTTP ${res.status}`, 'TOOL_ERROR');
    const contentLength = parseInt(res.headers.get('content-length') || '0', 10);
    if (contentLength > CONFIG.maxDownloadBytes) {
      throw new AppError(`download_file: file too large (${contentLength} bytes, max ${CONFIG.maxDownloadBytes})`, 'TOOL_ERROR');
    }
    const ab = await res.arrayBuffer();
    const buf = Buffer.from(ab);
    if (buf.length > CONFIG.maxDownloadBytes) {
      throw new AppError(`download_file: file too large (${buf.length} bytes, max ${CONFIG.maxDownloadBytes})`, 'TOOL_ERROR');
    }
    fs.mkdirSync(path.dirname(full), { recursive: true });
    fs.writeFileSync(full, buf);
    return `Saved ${buf.length} bytes to ${p}`;
  },

  // Delete a file (no error if it doesn't exist)
  async delete_file(args, ctx) {
    const { path: p } = args || {};
    assertString(p, 'path');
    const full = safePath(ctx.cwd, p);
    try {
      fs.unlinkSync(full);
      return `Deleted ${p}`;
    } catch (e) {
      if (e.code === 'ENOENT') return `No-op: ${p} not found`;
      throw new AppError(`delete_file failed: ${e.message}`, 'TOOL_ERROR');
    }
  },

  // --- Knowledge base tools ---
  // Compounding wiki pattern: ingest raw sources → compile into wiki → route via index
  // See AGENTS.md "Knowledge Agent Pattern" for the full workflow.

  async ingest_source(args, ctx) {
    const { title, content, source = 'user', tags = [], type = 'article' } = args || {};
    assertString(title, 'title');
    assertString(content, 'content');
    try {
      const slug = toSlug(title);
      const rawDir = safePath(ctx.cwd, 'context/raw');
      fs.mkdirSync(rawDir, { recursive: true });
      const tagList = Array.isArray(tags) ? tags : [tags];
      const now = new Date().toISOString().slice(0, 10);

      // Auto-split large content into parts (threshold: 8KB)
      const SPLIT_THRESHOLD = 8192;
      const chunks = [];
      if (content.length <= SPLIT_THRESHOLD) {
        chunks.push({ suffix: '', body: content });
      } else {
        // Split on heading boundaries (## or #), fall back to even splits
        const parts = content.split(/(?=^#{1,2}\s)/m).filter(p => p.trim());
        if (parts.length > 1) {
          parts.forEach((p, i) => chunks.push({ suffix: `-part-${i + 1}`, body: p.trim() }));
        } else {
          // No headings — split by character count
          for (let i = 0; i < content.length; i += SPLIT_THRESHOLD) {
            const partNum = Math.floor(i / SPLIT_THRESHOLD) + 1;
            chunks.push({ suffix: `-part-${partNum}`, body: content.slice(i, i + SPLIT_THRESHOLD) });
          }
        }
      }

      const manifestPath = safePath(ctx.cwd, 'context/raw/.manifest.json');
      let manifest = [];
      try {
        manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
        if (!Array.isArray(manifest)) manifest = [];
      } catch { /* file doesn't exist yet — start fresh */ }

      const files = [];
      for (const chunk of chunks) {
        const filename = `${slug}${chunk.suffix}.md`;
        const filePath = safePath(ctx.cwd, `context/raw/${filename}`);
        const partTitle = chunks.length > 1 ? `${title}${chunk.suffix}` : title;
        const frontmatter = [
          '---',
          `title: ${partTitle}`,
          `source: ${source}`,
          `ingested: ${now}`,
          `tags: [${tagList.join(', ')}]`,
          `type: ${type}`,
          `compiled: false`,
          chunks.length > 1 ? `parts: ${chunks.length}` : null,
          chunks.length > 1 ? `group: ${slug}` : null,
          '---',
        ].filter(Boolean).join('\n');
        fs.writeFileSync(filePath, `${frontmatter}\n\n${chunk.body}`, 'utf8');
        manifest.push({ file: filename, title: partTitle, source, ingested: now, compiled: false,
          ...(chunks.length > 1 ? { group: slug, parts: chunks.length } : {}) });
        files.push(filename);
      }

      fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2), 'utf8');

      if (files.length === 1) {
        return truncate(`Ingested "${title}" → context/raw/${files[0]}`);
      }
      return truncate(`Ingested "${title}" → split into ${files.length} parts:\n${files.map(f => `  context/raw/${f}`).join('\n')}`);
    } catch (error) {
      if (error instanceof AppError) throw error;
      throw new AppError(`ingest_source failed: ${error.message}`, 'TOOL_ERROR');
    }
  },

  async read_manifest(args, ctx) {
    const { filter = 'all' } = args || {};
    try {
      const manifestPath = safePath(ctx.cwd, 'context/raw/.manifest.json');
      let manifest = [];
      try {
        manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
        if (!Array.isArray(manifest)) manifest = [];
      } catch { /* no manifest yet */ }

      if (filter === 'uncompiled') {
        manifest = manifest.filter(e => !e.compiled);
      } else if (filter === 'compiled') {
        manifest = manifest.filter(e => e.compiled);
      }

      if (manifest.length === 0) return 'No entries' + (filter !== 'all' ? ` matching filter "${filter}"` : '') + '.';
      return truncate(JSON.stringify(manifest, null, 2));
    } catch (error) {
      if (error instanceof AppError) throw error;
      throw new AppError(`read_manifest failed: ${error.message}`, 'TOOL_ERROR');
    }
  },

  async mark_compiled(args, ctx) {
    const { file } = args || {};
    assertString(file, 'file');
    try {
      const manifestPath = safePath(ctx.cwd, 'context/raw/.manifest.json');
      let manifest;
      try {
        manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
        if (!Array.isArray(manifest)) throw new Error('not an array');
      } catch {
        throw new AppError('Manifest not found or invalid — ingest sources first', 'TOOL_ERROR');
      }

      const entry = manifest.find(e => e.file === file);
      if (!entry) throw new AppError(`File "${file}" not found in manifest`, 'TOOL_ERROR');
      entry.compiled = true;
      fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2), 'utf8');

      // Keep raw file frontmatter in sync
      const rawPath = safePath(ctx.cwd, `context/raw/${file}`);
      try {
        const raw = fs.readFileSync(rawPath, 'utf8');
        const updated = raw.replace(/^compiled:\s*false$/m, 'compiled: true');
        fs.writeFileSync(rawPath, updated, 'utf8');
      } catch { /* raw file may have been moved — manifest is authoritative */ }

      return truncate(`Marked "${file}" as compiled`);
    } catch (error) {
      if (error instanceof AppError) throw error;
      throw new AppError(`mark_compiled failed: ${error.message}`, 'TOOL_ERROR');
    }
  },

  async search_context(args, ctx) {
    const { query, path: searchPath = 'context', max_results = 10 } = args || {};
    assertString(query, 'query');
    try {
      const baseDir = safePath(ctx.cwd, searchPath);
      const cap = Math.max(1, Math.min(30, max_results));

      // Try rg (ripgrep) first, then grep, then JS fallback
      // Uses execFileSync — no shell, no injection risk
      function trySystemSearch() {
        const cmds = [
          { bin: 'rg', args: ['-in', '--no-heading', '--line-number', '-g', '*.md', '--max-count', '3', query, baseDir] },
          { bin: 'grep', args: ['-rin', '--include=*.md', '-m', '3', query, baseDir] },
        ];
        for (const cmd of cmds) {
          try {
            const out = execFileSync(cmd.bin, cmd.args, { timeout: 5000, maxBuffer: 1024 * 256 }).toString();
            return out;
          } catch (e) {
            // Exit code 1 = no matches (not an error), anything else = binary not found or real error
            if (e.status === 1) return '';
            continue;
          }
        }
        return null; // neither available
      }

      const sysResult = trySystemSearch();
      if (sysResult !== null) {
        // Parse grep/rg output: filepath:linenum:content
        if (!sysResult.trim()) return `No matches for "${query}" in ${searchPath}/`;
        const lines = sysResult.trim().split('\n').slice(0, cap * 3);
        const byFile = new Map();
        for (const line of lines) {
          const m = line.match(/^(.+?):(\d+):(.*)$/);
          if (!m) continue;
          const rel = path.relative(ctx.cwd, m[1]);
          if (!byFile.has(rel)) byFile.set(rel, []);
          if (byFile.get(rel).length < 3) {
            byFile.get(rel).push({ line: Number(m[2]), text: m[3].trim() });
          }
        }
        const results = [];
        for (const [file, matches] of byFile) {
          if (results.length >= cap) break;
          // Try to get title from frontmatter
          let title = path.basename(file, '.md');
          try {
            const head = fs.readFileSync(safePath(ctx.cwd, file), 'utf8').slice(0, 500);
            const { meta } = parseFrontmatter(head);
            if (meta.title) title = meta.title;
          } catch { /* skip */ }
          results.push({ file, title, matches });
        }
        if (results.length === 0) return `No matches for "${query}" in ${searchPath}/`;
        return truncate(JSON.stringify(results, null, 2));
      }

      // JS fallback — no rg or grep available
      const results = [];
      const queryLower = query.toLowerCase();
      function walk(dir) {
        let entries;
        try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
        for (const entry of entries) {
          if (results.length >= cap) return;
          const full = path.join(dir, entry.name);
          if (entry.isDirectory()) {
            if (!entry.name.startsWith('.')) walk(full);
          } else if (entry.name.endsWith('.md')) {
            try {
              const content = fs.readFileSync(full, 'utf8');
              if (content.toLowerCase().includes(queryLower)) {
                const { meta } = parseFrontmatter(content);
                const rel = path.relative(ctx.cwd, full);
                const idx = content.toLowerCase().indexOf(queryLower);
                const start = Math.max(0, idx - 40);
                const end = Math.min(content.length, idx + query.length + 60);
                const snippet = (start > 0 ? '...' : '') +
                  content.slice(start, end).replace(/\n/g, ' ').trim() +
                  (end < content.length ? '...' : '');
                results.push({ file: rel, title: meta.title || entry.name, snippet });
              }
            } catch { /* unreadable file — skip */ }
          }
        }
      }
      walk(baseDir);
      if (results.length === 0) return `No matches for "${query}" in ${searchPath}/`;
      return truncate(JSON.stringify(results, null, 2));
    } catch (error) {
      if (error instanceof AppError) throw error;
      throw new AppError(`search_context failed: ${error.message}`, 'TOOL_ERROR');
    }
  },

  async save_learning(args, ctx) {
    const { content, category = 'discovery' } = args || {};
    assertString(content, 'content');
    const validCategories = ['retrieval', 'pattern', 'correction', 'discovery'];
    const cat = validCategories.includes(category) ? category : 'discovery';
    try {
      const learningsPath = safePath(ctx.cwd, 'context/learnings.md');
      fs.mkdirSync(path.dirname(learningsPath), { recursive: true });
      const now = new Date().toISOString().slice(0, 10);
      const entry = `\n## [${cat}] — ${now}\n\n${content}\n\n---\n`;
      if (!fs.existsSync(learningsPath)) {
        fs.writeFileSync(learningsPath, `# Operational Learnings\n${entry}`, 'utf8');
      } else {
        fs.appendFileSync(learningsPath, entry, 'utf8');
      }
      return truncate(`Saved ${cat} learning to context/learnings.md`);
    } catch (error) {
      if (error instanceof AppError) throw error;
      throw new AppError(`save_learning failed: ${error.message}`, 'TOOL_ERROR');
    }
  },

  async read_section(args, ctx) {
    const { path: p, heading } = args || {};
    assertString(p, 'path');
    try {
      const full = safePath(ctx.cwd, p);
      const content = fs.readFileSync(full, 'utf8');
      const { body } = parseFrontmatter(content);

      // Split by headings (any level: #, ##, ###, etc.)
      const sections = [];
      let current = { heading: '(top)', level: 0, start: 0 };
      const lines = body.split('\n');
      let pos = 0;
      for (let i = 0; i < lines.length; i++) {
        const hMatch = lines[i].match(/^(#{1,6})\s+(.+)/);
        if (hMatch) {
          current.end = pos;
          current.content = body.slice(current.start, current.end);
          if (current.content.trim()) sections.push(current);
          current = { heading: hMatch[2].trim(), level: hMatch[1].length, start: pos };
        }
        pos += lines[i].length + 1;
      }
      current.end = body.length;
      current.content = body.slice(current.start, current.end);
      if (current.content.trim()) sections.push(current);

      // No heading specified — return table of contents with char counts
      if (!heading) {
        const toc = sections.map(s => {
          const indent = '  '.repeat(Math.max(0, s.level - 1));
          return `${indent}- ${s.heading} (${s.content.trim().length} chars)`;
        }).join('\n');
        return truncate(`Sections in ${p}:\n${toc}\n\nUse read_section with heading to read a specific section.`);
      }

      // Find matching section (case-insensitive partial match)
      const headingLower = heading.toLowerCase();
      const match = sections.find(s => s.heading.toLowerCase().includes(headingLower));
      if (!match) {
        const available = sections.map(s => s.heading).join(', ');
        return `Heading "${heading}" not found. Available: ${available}`;
      }
      return truncate(match.content, CONFIG.maxToolOutputChars * 2);
    } catch (error) {
      if (error instanceof AppError) throw error;
      throw new AppError(`read_section failed: ${error.message}`, 'TOOL_ERROR');
    }
  },

  // Spawn a focused subagent with its own fresh context.
  // The parent decomposes a big task into small chunks; each child gets a clean context window,
  // a focused instruction, and a limited turn budget. The child's final output is returned to
  // the parent — the parent never sees the child's intermediate tool results.
  async spawn_agent(args, ctx) {
    const { task, instruction, max_turns } = args || {};
    assertString(task, 'task');
    const depth = (ctx._spawnDepth || 0) + 1;
    if (depth > CONFIG.maxSpawnDepth) {
      throw new AppError(`Max spawn depth (${CONFIG.maxSpawnDepth}) exceeded — subagents cannot nest further`, 'TOOL_ERROR');
    }
    const childTurns = Math.max(1, Math.min(10, max_turns || CONFIG.spawnMaxTurns));
    const childInstruction = instruction
      ? `${instruction.trim()}\n\nYou have ${childTurns} turns. Be concise and focused. Call finish_task when done.`
      : `${AGENT_INSTRUCTION.trim()}\n\nYou are a focused subagent. Complete this specific task in ${childTurns} turns or fewer. Be concise. Call finish_task when done.`;
    try {
      logger.info(`Spawning subagent (depth ${depth}, turns ${childTurns}): ${task.slice(0, 80)}...`);
      // Build a minimal agent loop inline — fresh messages, shared provider
      const provider = ctx._provider;
      const messages = [
        { role: 'system', content: `${childInstruction}\n\n${TOOL_INSTRUCTIONS_FULL.trim()}` },
        { role: 'user', content: task }
      ];
      let result = '';
      for (let turn = 0; turn < childTurns; turn++) {
        if (turn > 0) {
          messages[0] = { role: 'system', content: `${childInstruction}\n\n${toolInstructionsBrief(turn, childTurns)}` };
        }
        const toSend = compressMessages(messages);
        const { content } = await provider.complete({ messages: toSend });
        messages.push({ role: 'assistant', content });
        if (!content?.trim()) continue;
        if (/<<AGENT_DONE>>|<<done>>/i.test(content)) { result = content; break; }
        const toolCalls = parseToolCalls(content);
        if (toolCalls.length > 0) {
          const results = await executeTools(toolCalls, { ...ctx, _spawnDepth: depth });
          const finishResult = results.find(r => r.name === 'finish_task' && r.status === 'ok');
          if (finishResult) { result = finishResult.text; break; }
          messages.push({ role: 'user', content: `[TOOL RESULTS]\n${results.map(r => r.text).join('\n')}` });
          continue;
        }
        result = content;
      }
      if (!result) result = messages.filter(m => m.role === 'assistant').pop()?.content || 'Subagent produced no output';
      // Strip the <<AGENT_DONE>> marker so parent sees clean text
      result = result.replace(/<<AGENT_DONE>>/g, '').trim();
      logger.info(`Subagent completed (depth ${depth})`);
      return truncate(result, CONFIG.maxToolOutputChars * 2, 'Subagent output truncated — ask for a more focused task');
    } catch (error) {
      if (error instanceof AppError) throw error;
      throw new AppError(`spawn_agent failed: ${error.message}`, 'TOOL_ERROR');
    }
  },

  // ---- Skills (Anthropic-style progressive disclosure) ----
  // list_skills returns Level-1 metadata (name + description) for every local SKILL.md.
  // Reads ctx._skills (seeded once in runAgent) to avoid rescanning disk per call.
  async list_skills(args, ctx) {
    const skills = ctx._skills || discoverLocalSkills(ctx.cwd);
    if (!skills.length) {
      return `[EMPTY] No skills found in ./${CONFIG.skillsDir}/. Install one with:\n  npx skills add <source>\nor copy a SKILL.md to ./${CONFIG.skillsDir}/<name>/SKILL.md`;
    }
    return skills.map(s => `- ${s.name}: ${s.description}`).join('\n');
  },

  // load_skill returns the full SKILL.md body. Subsequent reads of scripts/references/assets
  // go through read_file with paths relative to the skill's directory.
  async load_skill(args, ctx) {
    const { name } = args || {};
    assertString(name, 'name');
    const skills = ctx._skills || discoverLocalSkills(ctx.cwd);
    const match = skills.find(s => s.name === name) || skills.find(s => s.dir === name);
    if (!match) {
      const available = skills.map(s => s.name).join(', ') || '(none)';
      throw new AppError(`Skill not found: ${name}. Available: ${available}`, 'VALIDATION');
    }
    const skillMdPath = safePath(ctx.cwd, path.join(CONFIG.skillsDir, match.dir, 'SKILL.md'));
    const raw = fs.readFileSync(skillMdPath, 'utf8');
    const { body } = parseFrontmatter(raw);
    return truncate(
      [
        `[SKILL: ${match.name}]`,
        `Location: ${CONFIG.skillsDir}/${match.dir}/`,
        `Referenced files resolve under this directory — use read_file to open them.`,
        '---',
        body.trim(),
      ].join('\n'),
      CONFIG.maxToolOutputChars * 4,
      `Body truncated — open ${CONFIG.skillsDir}/${match.dir}/SKILL.md with read_file for the rest.`
    );
  },

  // discover_skills lists skills published at a remote /.well-known/agent-skills/index.json.
  // Read-only: installation is a separate step (`npx skills add` or add-skill.sh) so the stub
  // stays dependency-free.
  async discover_skills(args, ctx) {
    const { url } = args || {};
    assertString(url, 'url');
    const base = String(url).replace(/\/+$/, '').replace(/\/\.well-known\/(agent-skills|skills)(\/index\.json)?$/, '');
    const indexUrl = `${base}${WELL_KNOWN_SKILLS_PATH}`;
    checkUrlAllowed(indexUrl);
    const res = await fetch(indexUrl, { signal: ctx.signal, headers: { 'User-Agent': 'agent-builder/1.0' } });
    if (!res.ok) throw new AppError(`discover_skills: HTTP ${res.status} fetching ${indexUrl}`, 'TOOL_ERROR');
    let data;
    try { data = await res.json(); }
    catch (e) { throw new AppError(`discover_skills: invalid JSON at ${indexUrl}: ${e.message}`, 'TOOL_ERROR'); }
    if (!Array.isArray(data.skills) || !data.skills.length) {
      throw new AppError(`discover_skills: no skills in index at ${indexUrl}`, 'TOOL_ERROR');
    }
    const list = data.skills
      .map(s => `- ${s.name || '(unnamed)'} [${s.type || 'skill-md'}]: ${s.description || ''}`)
      .join('\n');
    return truncate([
      `Skills at ${indexUrl}:`,
      list,
      '',
      `Install one with:  npx skills add ${base} --skill <name>`,
      `Or copy the SKILL.md into ./${CONFIG.skillsDir}/<name>/SKILL.md and call load_skill.`,
    ].join('\n'));
  },

  // describe_mcp_tool returns the full JSONSchema for a remote MCP tool. Agents normally
  // only need the Level-1 signature we inject into the system prompt (`args: {a, b?}`),
  // but fall back to this for tools with complex nested schemas, enum constraints, or
  // descriptions buried in schema `description` fields.
  async describe_mcp_tool(args, ctx) {
    const { name } = args || {};
    assertString(name, 'name');
    const clients = ctx._mcpClients || [];
    for (const client of clients) {
      const prefix = `${client.name}_`;
      if (!name.startsWith(prefix)) continue;
      const toolName = name.slice(prefix.length);
      const tool = client.tools.find(t => t.name === toolName);
      if (!tool) continue;
      return truncate([
        `[mcp:${client.name}] ${tool.name}`,
        tool.description || '(no description)',
        '',
        'Input schema:',
        JSON.stringify(tool.inputSchema || {}, null, 2),
      ].join('\n'), CONFIG.maxToolOutputChars * 2);
    }
    const available = clients
      .flatMap(c => c.tools.map(t => `${c.name}_${t.name}`))
      .join(', ') || '(no MCP tools connected)';
    throw new AppError(`describe_mcp_tool: ${name} not found. Available: ${available}`, 'VALIDATION');
  },

  // run_in_container executes a shell command inside an isolated OCI container.
  //
  // When to reach for this:
  //   - A skill bundles untrusted scripts/ that need to execute
  //   - The agent needs to run a shell command that should not touch the host FS or network
  //   - A task requires a runtime (Python, Node, Go…) not installed locally
  //
  // Prefers Apple's `container` CLI on macOS Apple Silicon (zero deps; see the bundled
  // apple-container skill). Falls back to `docker` if `container` is not installed. Refuses
  // cleanly if neither is available.
  //
  // Defaults are deny-by-default: `--network none` (no egress), no writable host mounts.
  // Mounts pass through safePath so they cannot escape --cwd. Agent opts in explicitly.
  async run_in_container(args, ctx) {
    const { image, command, mounts = [], workdir, timeout_ms = CONFIG.toolTimeoutMs, network = 'none' } = args || {};
    assertString(image, 'image');
    assertString(command, 'command');

    // Detect runtime. Prefer Apple `container` (native, lightweight); fall back to docker.
    let runtime = null;
    for (const candidate of ['container', 'docker']) {
      try {
        execFileSync(candidate, ['--version'], { stdio: 'ignore', timeout: 2000 });
        runtime = candidate;
        break;
      } catch { /* not installed; try next */ }
    }
    if (!runtime) {
      throw new AppError(
        "run_in_container: neither `container` (Apple Silicon) nor `docker` is installed. " +
        "Load the apple-container skill with load_skill for install instructions, or install Docker.",
        'TOOL_ERROR'
      );
    }

    const cliArgs = ['run', '--rm'];
    if (network === 'none') cliArgs.push('--network', 'none');
    else if (network && network !== 'default') cliArgs.push('--network', String(network));
    if (workdir) cliArgs.push('-w', String(workdir));
    for (const m of mounts) {
      if (typeof m !== 'string' || !m) continue;
      // Mount spec: `host:container[:ro]` — resolve host through safePath so agents
      // cannot bind-mount paths outside --cwd (e.g. /Users/... / /etc).
      const [hostPart, ...rest] = m.split(':');
      const safeHost = safePath(ctx.cwd, hostPart);
      cliArgs.push('-v', `${safeHost}:${rest.join(':')}`);
    }
    cliArgs.push(image, 'sh', '-lc', command);

    try {
      const out = execFileSync(runtime, cliArgs, {
        timeout: Math.max(1000, Math.min(timeout_ms, 10 * 60_000)),
        encoding: 'utf8',
        maxBuffer: 1024 * 1024,
        stdio: ['ignore', 'pipe', 'pipe'],
      });
      return truncate(`[${runtime}] exit=0\n${out || '(empty stdout)'}`);
    } catch (e) {
      const stderr = (e.stderr && e.stderr.toString()) || e.message || '';
      throw new AppError(`run_in_container (${runtime}) failed: ${stderr.slice(0, 400)}`, 'TOOL_ERROR');
    }
  },

  // extract_skill captures a methodology the agent just demonstrated as a reusable SKILL.md
  // draft. Writes under CONFIG.skillsDir/drafts/<name>/ — same root discoverLocalSkills scans,
  // but the reserved `drafts` name is excluded from discovery so drafts stay invisible to the
  // harness until the user promotes them. Visible in Finder/ls so non-technical users can
  // browse and read drafts before promoting.
  //
  // The agent supplies structure explicitly (name, description, when_to_use, steps[]).
  // The tool does not infer — self-extraction on small models is unreliable and a bad SKILL.md
  // pollutes the registry. Each step must include success_criteria (per Skillify convention).
  async extract_skill(args, ctx) {
    const { name, description, when_to_use, steps, goal, inputs, rules } = args || {};
    assertString(name, 'name');
    assertString(description, 'description');
    assertString(when_to_use, 'when_to_use');
    if (!Array.isArray(steps) || !steps.length) {
      throw new AppError('extract_skill: steps must be a non-empty array', 'VALIDATION');
    }
    // agentskills.io naming: 1-64 chars, lowercase alphanumeric + hyphens,
    // no leading/trailing/consecutive hyphens.
    if (!/^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$/.test(name) || /--/.test(name)) {
      throw new AppError(
        'extract_skill: name must be 1-64 chars, lowercase alphanumeric and hyphens (no leading, trailing, or consecutive hyphens)',
        'VALIDATION'
      );
    }

    // Flatten multi-line scalars to keep the YAML frontmatter parseable by strict readers.
    const flatten = s => String(s).replace(/\r?\n/g, ' ').trim();
    const descLine = flatten(description);
    const title = name.split('-').map(w => w ? w[0].toUpperCase() + w.slice(1) : '').join(' ');

    const out = [
      '---',
      `name: ${name}`,
      `description: ${descLine}`,
      '---',
      '',
      `# ${title}`,
      '',
      descLine,
      '',
      '## When to Use',
      '',
      flatten(when_to_use),
      '',
    ];

    if (typeof goal === 'string' && goal.trim()) {
      out.push('## Goal', '', goal.trim(), '');
    }

    if (Array.isArray(inputs) && inputs.length) {
      out.push('## Inputs', '');
      for (const input of inputs) {
        if (input && typeof input.name === 'string' && typeof input.description === 'string') {
          out.push(`- \`$${input.name}\`: ${flatten(input.description)}`);
        }
      }
      out.push('');
    }

    out.push('## Steps', '');
    steps.forEach((step, i) => {
      if (!step || typeof step !== 'object') {
        throw new AppError(`extract_skill: step ${i + 1} must be an object`, 'VALIDATION');
      }
      const stepTitle = typeof step.title === 'string' && step.title.trim() ? step.title.trim() : `Step ${i + 1}`;
      out.push(`### ${i + 1}. ${stepTitle}`, '');

      if (typeof step.actions === 'string' && step.actions.trim()) {
        out.push(step.actions.trim(), '');
      } else if (Array.isArray(step.actions) && step.actions.length) {
        for (const action of step.actions) {
          if (typeof action === 'string') out.push(`- ${action}`);
        }
        out.push('');
      }

      const criteria = step.success_criteria;
      if (typeof criteria === 'string' && criteria.trim()) {
        out.push(`**Success criteria**: ${criteria.trim()}`, '');
      } else if (Array.isArray(criteria) && criteria.length) {
        out.push('**Success criteria**:');
        for (const c of criteria) {
          if (typeof c === 'string') out.push(`- ${c}`);
        }
        out.push('');
      } else {
        throw new AppError(`extract_skill: step ${i + 1} missing success_criteria`, 'VALIDATION');
      }

      if (typeof step.artifacts === 'string' && step.artifacts.trim()) {
        out.push(`**Artifacts**: ${step.artifacts.trim()}`, '');
      }
      if (typeof step.rules === 'string' && step.rules.trim()) {
        out.push(`**Rules**: ${step.rules.trim()}`, '');
      }
    });

    if (Array.isArray(rules) && rules.length) {
      out.push('## Rules', '');
      for (const r of rules) {
        if (typeof r === 'string') out.push(`- ${r}`);
      }
      out.push('');
    }

    const body = out.join('\n');
    const draftDir = safePath(ctx.cwd, path.join(CONFIG.skillsDir, SKILL_DRAFTS_DIRNAME, name));
    fs.mkdirSync(draftDir, { recursive: true });
    const outPath = path.join(draftDir, 'SKILL.md');
    fs.writeFileSync(outPath, body, 'utf8');

    const relPath = path.relative(ctx.cwd, outPath);
    return truncate([
      `[SKILL DRAFT SAVED] ${relPath}`,
      `(${body.length} chars, ${steps.length} step(s))`,
      '',
      `Drafts live under ${CONFIG.skillsDir}/${SKILL_DRAFTS_DIRNAME}/ — readable in Finder, excluded from turn-1 disclosure.`,
      `To promote:  mv ${CONFIG.skillsDir}/${SKILL_DRAFTS_DIRNAME}/${name} ${CONFIG.skillsDir}/${name}`,
    ].join('\n'));
  },

  // Signal that the task is complete. The agent loop checks for <<AGENT_DONE>> to stop cleanly.
  // This is better than hoping the model stops on its own — local models often ramble past the
  // answer or get stuck in loops without an explicit finish mechanism.
  async finish_task(args, ctx) {
    const { summary, files_created } = args || {};
    assertString(summary, 'summary');
    const fileList = Array.isArray(files_created) && files_created.length
      ? `\nFiles: ${files_created.join(', ')}`
      : '';
    return `<<AGENT_DONE>>${fileList}\n${summary}`;
  },

  // TODO: ADD YOUR TOOLS HERE
  // Replace example_tool above with your domain-specific tools.
  // Follow the same pattern: extract args → validate → do work → return truncated result.
  // Built-in tools (list_files, read_file, write_file, fetch_url, search_web, scrape_page,
  // download_file, delete_file, define_tool, finish_task, spawn_agent) and knowledge tools
  // (ingest_source, read_manifest, mark_compiled, search_context, save_learning, read_section)
  // are available.
};

// ======== AGENT CONFIGURATION ========
// ======== Universal scaffold + rules ========
const AGENT_INSTRUCTION = `
// TODO: AI, modify this section based on user requirements
// Fill in [BRACKETED] placeholders to create the specific agent
// IMPORTANT: Do NOT call any tools until you have replaced ALL [BRACKETED] placeholders
// in the section below with concrete content. If something is ambiguous, pick a sensible
// default and proceed — do not ask the user to clarify.

You are a [ROLE/TYPE] specialized in [DOMAIN/EXPERTISE].

Your approach:
1. [First step for this type of agent]
2. [Second step in the workflow]
3. [Continue with domain-specific steps]
4. [Final output/verification step]

Output format:
- [What format: Markdown, JSON, code files, etc.]
- [What to include: sections, fields, structure]
- [Where to save: ./output/, ./reports/, etc.]

Focus on:
- [Key quality criteria for this domain]
- [Important considerations]
- [Specific requirements]
`;

// Full tool instructions — sent on turn 1 only to save context on subsequent turns
const TOOL_INSTRUCTIONS_FULL = `
When you need to use a tool, emit the exact syntax:
<<tool:tool_name {"parameter": "value"}>>

Available tools: ${toolListInline()}

Quick reference:
${toolBullets()}

Rules:
- Use strict JSON in tool calls (no trailing commas, quoted keys).
- Make multiple focused calls instead of one huge one.
- If a step fails, try an alternative and explain what changed.
- Keep outputs concise and well-organized.
- Before any tool calls, rewrite the bracketed scaffold with concrete values.
- If you must assume something, state the assumption briefly and continue.
- When done, call finish_task with a summary of what was accomplished.

First‑Turn Protocol (MUST DO):
1. Agent Setup — Overwrite the scaffold with concrete values.
2. Plan — Provide a short bullet plan listing actions and tools.
3. Execute — Call tools using strict JSON payloads.
4. Deliver — Call finish_task with a summary and list of created files.
`;

// Brief reminder — sent on turn 2+ to conserve context for local models
function toolInstructionsBrief(turn, maxTurns) {
  return `Turn ${turn + 1}/${maxTurns}. Tools: ${toolListInline()}. Syntax: <<tool:name {"arg":"val"}>>\nWhen done, call finish_task.`;
}

// Combine agent persona + full tool instructions for the first system message
const FULL_INSTRUCTION = `${AGENT_INSTRUCTION.trim()}\n\n${TOOL_INSTRUCTIONS_FULL.trim()}`;

// ======== PROVIDERS ========
class OllamaProvider {
  constructor({ model = 'mistral-small', host = process.env.OLLAMA_HOST || 'http://localhost:11434' }) {
    this.model = model;
    this.host = host.replace(/\/$/, '');
  }

  async complete({ messages, signal }) {
    try {
      const res = await fetch(`${this.host}/api/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ model: this.model, messages, stream: false }),
        signal
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      return { content: data.message?.content || '', done: data.done };
    } catch (e) {
      throw new AppError(`Ollama error: ${e.message}`, 'PROVIDER');
    }
  }
}

class OpenAIProvider {
  constructor({ model = 'gpt-5-mini', apiKey, baseUrl = process.env.OPENAI_BASE_URL || 'https://api.openai.com' }) {
    this.model = model;
    this.apiKey = apiKey;
    this.baseUrl = baseUrl.replace(/\/$/, '');
  }
  async complete({ messages, signal }) {
    try {
      const res = await fetch(`${this.baseUrl}/v1/chat/completions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${this.apiKey}`,
        },
        body: JSON.stringify({ model: this.model, messages, stream: false }),
        signal,
      });
      const text = await res.text();
      if (!res.ok) throw new Error(`HTTP ${res.status}: ${text.slice(0, 200)}`);
      const data = JSON.parse(text);
      const content = data.choices?.[0]?.message?.content ?? '';
      const finish = data.choices?.[0]?.finish_reason ?? 'stop';
      return { content, done: finish !== 'length' };
    } catch (e) {
      throw new AppError(`OpenAI error: ${e.message}`, 'PROVIDER');
    }
  }
}

class AnthropicProvider {
  constructor({
    model = 'claude-sonnet-4-5-20250929',
    apiKey,
    version = process.env.ANTHROPIC_VERSION || '2023-06-01',
    baseUrl = process.env.ANTHROPIC_BASE_URL || 'https://api.anthropic.com'
  }) {
    this.model = model;
    this.apiKey = apiKey;
    this.version = version;
    this.baseUrl = baseUrl.replace(/\/$/, '');
  }
  async complete({ messages, signal }) {
    try {
      const system = messages.filter(m => m.role === 'system').map(m => String(m.content || '')).join('\n');
      const convo = messages
        .filter(m => m.role !== 'system')
        .map(m => ({
          role: m.role === 'assistant' ? 'assistant' : 'user',
          content: [{ type: 'text', text: String(m.content || '') }]
        }));
      const body = { model: this.model, max_tokens: CONFIG.maxLLMOutputTokens, messages: convo };
      if (system) body.system = system;

      const res = await fetch(`${this.baseUrl}/v1/messages`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-api-key': this.apiKey,
          'anthropic-version': this.version
        },
        body: JSON.stringify(body),
        signal
      });
      const text = await res.text();
      if (!res.ok) throw new Error(`HTTP ${res.status}: ${text.slice(0, 200)}`);
      const data = JSON.parse(text);
      const parts = data.content || [];
      const firstText = parts.find(p => p && (p.text || p.type === 'text'))?.text ?? '';
      return { content: firstText, done: true };
    } catch (e) {
      throw new AppError(`Anthropic error: ${e.message}`, 'PROVIDER');
    }
  }
}

class GeminiProvider {
  constructor({ model = 'gemini-2.5-flash', apiKey, baseUrl = 'https://generativelanguage.googleapis.com' }) {
    this.model = model;
    this.apiKey = apiKey;
    this.baseUrl = baseUrl.replace(/\/$/, '');
  }
  async complete({ messages, signal }) {
    try {
      const system = messages.filter(m => m.role === 'system').map(m => String(m.content || '')).join('\n');
      const contents = messages
        .filter(m => m.role !== 'system')
        .map(m => ({
          role: m.role === 'assistant' ? 'model' : 'user',
          parts: [{ text: String(m.content || '') }]
        }));
      const body = { contents };
      if (system) body.systemInstruction = { parts: [{ text: system }] };

      const url = `${this.baseUrl}/v1beta/models/${encodeURIComponent(this.model)}:generateContent?key=${encodeURIComponent(this.apiKey)}`;
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        signal
      });
      const text = await res.text();
      if (!res.ok) throw new Error(`HTTP ${res.status}: ${text.slice(0, 200)}`);
      const data = JSON.parse(text);
      const cand = data.candidates?.[0];
      const parts = cand?.content?.parts || [];
      const out = parts.map(p => p.text || '').join('');
      return { content: out, done: true };
    } catch (e) {
      throw new AppError(`Gemini error: ${e.message}`, 'PROVIDER');
    }
  }
}

// ======== MCP (Model Context Protocol) CLIENT ========
// Minimal stdio MCP client — speaks newline-delimited JSON-RPC 2.0 to a child process
// server. Covers the subset agent-builder needs: initialize handshake + tools/list +
// tools/call. Does NOT implement streamable-HTTP transport, resources/prompts, sampling,
// or server-initiated notifications (logged and ignored).
//
// Why progressive disclosure applies here too: at turn 1 the agent sees just the tool
// name + one-line description per MCP tool. Full JSONSchema stays on the server until
// the agent calls describe_mcp_tool, and parameters only materialize when the agent
// actually invokes the tool. Same shape as skills, different source.
class MCPClient {
  constructor({ name, command, args = [], env = {} }) {
    this.name = name;
    this.command = command;
    this.args = args;
    this.env = env;
    this.proc = null;
    this.nextId = 1;
    this.pending = new Map(); // id -> { resolve, reject }
    this.tools = [];
    this.buffer = '';
    this.closed = false;
  }

  async connect(timeoutMs = CONFIG.mcpConnectTimeoutMs) {
    this.proc = spawn(this.command, this.args, {
      stdio: ['pipe', 'pipe', 'pipe'],
      env: { ...process.env, ...this.env },
    });
    this.proc.stdout.setEncoding('utf8');
    this.proc.stderr.setEncoding('utf8');
    this.proc.stdout.on('data', chunk => this._onData(chunk));
    // Many MCP servers log human-readable messages to stderr; surface them at debug level.
    this.proc.stderr.on('data', chunk => logger.debug(`[mcp:${this.name}] ${String(chunk).trim()}`));
    this.proc.on('exit', code => {
      this.closed = true;
      this._rejectAll(new AppError(`mcp:${this.name} exited (code=${code})`, 'TOOL_ERROR'));
    });
    this.proc.on('error', err => {
      this._rejectAll(new AppError(`mcp:${this.name} process error: ${err.message}`, 'TOOL_ERROR'));
    });

    // Protocol version 2025-06-18 is the current MCP stable. Most servers accept older
    // versions too; if they don't, the server returns an error from `initialize`.
    await this._request('initialize', {
      protocolVersion: '2025-06-18',
      capabilities: {},
      clientInfo: { name: 'agent-builder', version: '1.0' },
    }, timeoutMs);
    this._notify('notifications/initialized');

    const listResult = await this._request('tools/list', {}, timeoutMs);
    this.tools = Array.isArray(listResult?.tools) ? listResult.tools : [];
    return this.tools;
  }

  async callTool(name, args, timeoutMs = CONFIG.mcpCallTimeoutMs) {
    const res = await this._request('tools/call', { name, arguments: args || {} }, timeoutMs);
    const text = (res?.content || [])
      .filter(c => c && c.type === 'text' && typeof c.text === 'string')
      .map(c => c.text)
      .join('\n');
    if (res?.isError) {
      throw new AppError(`mcp:${this.name}:${name} ${text || 'tool reported an error'}`, 'TOOL_ERROR');
    }
    return text || '(tool returned no text content)';
  }

  close() {
    if (this.proc && !this.closed) {
      this.closed = true;
      try { this.proc.kill('SIGTERM'); } catch { /* already dead */ }
    }
  }

  _onData(chunk) {
    this.buffer += chunk;
    let idx;
    while ((idx = this.buffer.indexOf('\n')) >= 0) {
      const line = this.buffer.slice(0, idx).trim();
      this.buffer = this.buffer.slice(idx + 1);
      if (!line) continue;
      let msg;
      try { msg = JSON.parse(line); }
      catch { logger.debug(`[mcp:${this.name}] non-JSON stdout: ${line.slice(0, 200)}`); continue; }
      // Response (has id AND result/error) → resolve the pending request.
      if (msg.id !== undefined && this.pending.has(msg.id)) {
        const { resolve, reject } = this.pending.get(msg.id);
        this.pending.delete(msg.id);
        if (msg.error) reject(new AppError(`mcp:${this.name} ${msg.error.code}: ${msg.error.message}`, 'TOOL_ERROR'));
        else resolve(msg.result);
      } else {
        // Server-initiated notification — we don't act on these (no listChanged handling yet).
        logger.debug(`[mcp:${this.name}] notification: ${msg.method || '(unknown)'}`);
      }
    }
  }

  _request(method, params, timeoutMs) {
    if (this.closed) return Promise.reject(new AppError(`mcp:${this.name} closed`, 'TOOL_ERROR'));
    const id = this.nextId++;
    const line = JSON.stringify({ jsonrpc: '2.0', id, method, params }) + '\n';
    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        this.pending.delete(id);
        reject(new AppError(`mcp:${this.name} ${method} timed out after ${timeoutMs}ms`, 'TOOL_ERROR'));
      }, timeoutMs);
      this.pending.set(id, {
        resolve: v => { clearTimeout(timer); resolve(v); },
        reject: e => { clearTimeout(timer); reject(e); },
      });
      this.proc.stdin.write(line);
    });
  }

  _notify(method, params) {
    if (this.closed) return;
    const payload = { jsonrpc: '2.0', method };
    if (params) payload.params = params;
    this.proc.stdin.write(JSON.stringify(payload) + '\n');
  }

  _rejectAll(err) {
    for (const { reject } of this.pending.values()) reject(err);
    this.pending.clear();
  }
}

// Load MCP server config. CONFIG.mcpServers wins if set; otherwise fall back to ./mcp.json
// in the cwd. Accepts {servers:{...}}, {mcpServers:{...}}, or a flat {...} at the root.
function loadMcpConfig(cwd) {
  if (CONFIG.mcpServers && Object.keys(CONFIG.mcpServers).length) return CONFIG.mcpServers;
  const p = path.join(cwd, 'mcp.json');
  try {
    const raw = fs.readFileSync(p, 'utf8');
    const parsed = JSON.parse(raw);
    if (parsed && typeof parsed === 'object') {
      if (parsed.servers && typeof parsed.servers === 'object') return parsed.servers;
      if (parsed.mcpServers && typeof parsed.mcpServers === 'object') return parsed.mcpServers;
      return parsed;
    }
  } catch { /* no config, no MCP — silent */ }
  return {};
}

// Connect to every configured server in parallel, register proxies into ToolRegistry.
// Returns { clients, summary } — clients stay alive for the run; summary is the block
// appended to the system prompt at turn 1 and on every subsequent turn.
async function connectMcpServers(cwd) {
  const servers = loadMcpConfig(cwd);
  const entries = Object.entries(servers);
  if (!entries.length) return { clients: [], summary: '' };

  const settled = await Promise.allSettled(entries.map(async ([name, cfg]) => {
    if (!cfg || typeof cfg.command !== 'string') {
      throw new AppError(`mcp:${name} config missing "command"`, 'CONFIG');
    }
    const client = new MCPClient({ name, command: cfg.command, args: cfg.args || [], env: cfg.env || {} });
    await client.connect();
    return client;
  }));

  const clients = [];
  const lines = [];
  settled.forEach((res, i) => {
    const [name] = entries[i];
    if (res.status === 'rejected') {
      logger.warn(`[mcp:${name}] skipped: ${res.reason?.message || res.reason}`);
      return;
    }
    const client = res.value;
    clients.push(client);
    logger.info(`[mcp:${name}] ${client.tools.length} tool(s)`);
    for (const t of client.tools) {
      const proxyName = `${name}_${t.name}`;
      if (ToolRegistry[proxyName]) {
        logger.warn(`[mcp:${name}] name collision: ${proxyName} already registered, skipping`);
        continue;
      }
      // Proxy: call the remote tool, return its concatenated text content.
      ToolRegistry[proxyName] = async (args) => {
        const text = await client.callTool(t.name, args || {});
        return truncate(text);
      };
      // Build a short doc line with parameter names from the schema — enough for the
      // LLM to call it without fetching the full schema via describe_mcp_tool.
      const required = Array.isArray(t.inputSchema?.required) ? t.inputSchema.required : [];
      const props = Object.keys(t.inputSchema?.properties || {});
      const paramPart = props.length
        ? ` args: {${props.map(p => required.includes(p) ? p : `${p}?`).join(', ')}}`
        : '';
      const desc1 = (t.description || '').split(/\r?\n/)[0].trim();
      TOOL_DOCS[proxyName] = `[mcp:${name}] ${desc1}${paramPart}`;
      lines.push(`- ${proxyName}: ${desc1}`);
    }
  });

  const summary = lines.length
    ? `\n\nMCP tools (call by name; use describe_mcp_tool for full schema):\n${lines.join('\n')}`
    : '';
  return { clients, summary };
}

function splitPrefixedModel(spec) {
  const s = (spec || '').trim();
  const m = s.match(/^([a-z]+):(.+)$/i);
  if (m) {
    const p = m[1].toLowerCase();
    if (p === 'openai' || p === 'anthropic' || p === 'gemini' || p === 'ollama') {
      return { provider: p, model: m[2] };
    }
  }
  return { provider: '', model: s };
}

function inferProviderFromModel(model) {
  const s = (model || '').toLowerCase();
  if (!s) return '';
  // OpenAI models: gpt-5 family, gpt-4 family, gpt-3.5, o-series
  if (/^(gpt-[345]|o[1-9])/.test(s)) return 'openai';
  // Anthropic models: must start with "claude" (avoids matching random models with "sonnet"/"opus" in name)
  if (/^claude/.test(s)) return 'anthropic';
  // Gemini models: must start with "gemini" (avoids matching random models with "flash"/"pro" in name)
  if (/^gemini/.test(s)) return 'gemini';
  return '';
}

async function createProvider({ modelSpec, providerHint = '', keys = {}, cwd = process.cwd(), saveKeys = false }) {
  const { provider: prefixProvider, model: stripped } = splitPrefixedModel(modelSpec || '');
  let provider = (providerHint || prefixProvider || '').toLowerCase();
  let model = stripped || modelSpec || '';

  // Default to ollama unless an explicit provider is set or model clearly implies a cloud provider
  if (!provider) provider = inferProviderFromModel(model) || 'ollama';
  if (!model) {
    if (provider === 'ollama') model = 'mistral-small';
    if (provider === 'openai') model = 'gpt-5-mini';  // Updated to latest
    if (provider === 'anthropic') model = 'claude-sonnet-4-5-20250929';  // Updated to 4.5
    if (provider === 'gemini') model = 'gemini-2.5-flash';  // Updated to 2.5
  }

  switch (provider) {
    case 'openai': {
      const apiKey = await ensureApiKey({
        envName: 'OPENAI_API_KEY',
        cliValue: keys.openaiKey,
        promptLabel: 'Enter OPENAI_API_KEY',
        cwd,
        saveToEnv: saveKeys
      });
      return new OpenAIProvider({ model, apiKey });
    }
    case 'anthropic': {
      const apiKey = await ensureApiKey({
        envName: 'ANTHROPIC_API_KEY',
        cliValue: keys.anthropicKey,
        promptLabel: 'Enter ANTHROPIC_API_KEY',
        cwd,
        saveToEnv: saveKeys
      });
      return new AnthropicProvider({ model, apiKey });
    }
    case 'gemini': {
      const apiKey = await ensureApiKey({
        envName: 'GEMINI_API_KEY',
        cliValue: keys.geminiKey || process.env.GOOGLE_API_KEY, // accept GOOGLE_API_KEY too
        promptLabel: 'Enter GEMINI_API_KEY (Google AI Studio key)',
        cwd,
        saveToEnv: saveKeys
      });
      return new GeminiProvider({ model, apiKey });
    }
    case 'ollama':
    default:
      return new OllamaProvider({ model: model || undefined, host: process.env.OLLAMA_HOST || 'http://localhost:11434' });
  }
}

// ======== RUNTIME ENGINE ========
function parseToolCalls(text) {
  const calls = [];
  let i = 0;
  while (i < text.length) {
    const start = text.indexOf('<<tool:', i);
    if (start === -1) break;
    const nameStart = start + '<<tool:'.length;
    let nameEnd = nameStart;
    while (nameEnd < text.length && /\w/.test(text[nameEnd])) nameEnd++;
    const name = text.slice(nameStart, nameEnd);
    // Skip whitespace to first '{'
    let j = nameEnd;
    while (j < text.length && /\s/.test(text[j])) j++;
    if (text[j] !== '{') { i = nameEnd; continue; }
    // Balanced-brace parse for JSON object
    let depth = 0, k = j, inStr = false, esc = false;
    for (; k < text.length; k++) {
      const ch = text[k];
      if (inStr) {
        if (esc) { esc = false; }
        else if (ch === '\\') { esc = true; }
        else if (ch === '"') { inStr = false; }
        continue;
      }
      if (ch === '"') { inStr = true; continue; }
      if (ch === '{') depth++;
      else if (ch === '}') {
        depth--;
        if (depth === 0) { k++; break; }
      }
    }
    const jsonStr = text.slice(j, k);
    // Expect closing '>>'
    const close = text.indexOf('>>', k);
    if (close === -1) { i = k; continue; }
    try {
      calls.push({ name, args: tryParseJSON(jsonStr) });
    } catch (e) {
      logger.warn(`Failed to parse tool call for ${name}: ${e.message}`);
    }
    i = close + 2;
  }
  return calls;
}

async function executeSingleTool(call, ctx) {
  const tool = ToolRegistry[call.name];
  if (!tool) {
    return { name: call.name, status: 'fail', text: formatError(call.name, { message: `Unknown tool: ${call.name}. Use help to list available tools.`, code: '' }) };
  }

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), CONFIG.toolTimeoutMs);

  try {
    const output = await tool(call.args, { ...ctx, signal: controller.signal });
    const text = truncate(output);
    const isEmpty = !text || !text.trim();
    return {
      name: call.name,
      status: isEmpty ? 'empty' : 'ok',
      text: isEmpty ? `[EMPTY] ${call.name}: no output` : `[OK] ${call.name}: ${text}`
    };
  } catch (e) {
    return { name: call.name, status: 'fail', text: formatError(call.name, e) };
  } finally {
    clearTimeout(timeout);
  }
}

async function executeTools(calls, ctx) {
  // Run all calls in parallel — independent tool invocations don't need to wait for each other
  return Promise.all(calls.map(call => executeSingleTool(call, ctx)));
}

// Compress older messages to free context for local models.
// Keeps the system message, the last 4 messages, and summarizes everything in between.
function compressMessages(messages) {
  if (messages.length <= 6) return messages;

  const system = messages[0];
  const middle = messages.slice(1, -4);
  const recent = messages.slice(-4);

  const summary = middle
    .filter(m => m.role === 'assistant' || m.content.startsWith('[TOOL'))
    .map(m => {
      const preview = m.content.slice(0, 150).replace(/\n/g, ' ');
      return m.role === 'assistant' ? `Assistant: ${preview}` : preview;
    })
    .join('\n');

  return [
    system,
    { role: 'user', content: `[Earlier work summary]\n${summary}` },
    ...recent
  ];
}

async function runAgent({ task, model, provider: providerHint, openaiKey, anthropicKey, geminiKey, saveKeys, yolo = false, cwd = process.cwd() }) {
  const provider = await createProvider({
    modelSpec: model,
    providerHint,
    keys: { openaiKey, anthropicKey, geminiKey },
    cwd,
    saveKeys
  });
  logger.info(`Provider: ${provider.constructor.name}, Model: ${provider.model || '(default)'}`);

  // Level-1 skill disclosure: scan once and append to the system prompt so the agent knows
  // what skills exist without having to call list_skills first. The bodies stay on disk.
  const skills = discoverLocalSkills(cwd);
  const skillsPreview = formatSkillsForPrompt(skills);
  if (skills.length) {
    logger.info(`Skills available: ${skills.map(s => s.name).join(', ')}`);
  }

  // Connect to any configured MCP servers. Each server's tools get registered into
  // ToolRegistry as `<server>_<tool>` so the agent calls them with the same syntax as
  // built-ins. `mcpSummary` is a compact block we append to both the turn-1 system
  // prompt and the turn-2+ brief so the agent keeps seeing MCP tools as the turns run.
  const { clients: mcpClients, summary: mcpSummary } = await connectMcpServers(cwd);
  if (mcpClients.length) {
    logger.info(`MCP servers connected: ${mcpClients.map(c => c.name).join(', ')}`);
  }
  const closeMcp = () => { for (const c of mcpClients) c.close(); };

  try {
  const messages = [
    { role: 'system', content: `${FULL_INSTRUCTION}${skillsPreview}${mcpSummary}` },
    { role: 'user', content: task }
  ];
  let lastToolCallCount = 0;

  for (let turn = 0; turn < CONFIG.maxTurns; turn++) {
    logger.debug(`Turn ${turn + 1}/${CONFIG.maxTurns}`);

    // Turn-aware prompting: swap system message to brief version after turn 1
    if (turn > 0) {
      messages[0] = {
        role: 'system',
        content: `${AGENT_INSTRUCTION.trim()}\n\n${toolInstructionsBrief(turn, CONFIG.maxTurns)}${skillsPreview}${mcpSummary}`
      };
    }

    // Compress older messages to conserve context for local models
    const toSend = compressMessages(messages);

    const { content, done } = await provider.complete({ messages: toSend });
    logger.debug(`Response length: ${content?.length || 0} chars, done: ${done}`);
    if (content?.trim()) { logger.debug(`Response preview: ${content.slice(0, 300).replace(/\n/g, '\\n')}...`); }
    messages.push({ role: 'assistant', content });

    // Skip empty responses entirely
    if (!content?.trim()) {
      logger.debug('Skipping empty response');
      continue;
    }

    // Check for explicit finish via finish_task tool or <<done>> / <<AGENT_DONE>>
    if (/<<AGENT_DONE>>|<<done>>/i.test(content)) {
      return content;
    }

    const toolCalls = parseToolCalls(content);
    lastToolCallCount = toolCalls.length;

    if (toolCalls.length > 0) {
      logger.info(`Found ${toolCalls.length} tool call(s)`);

      if (!yolo) {
        console.log('\n=== Tool Calls Detected ===');
        toolCalls.forEach(c => {
          console.log(`- ${c.name}: ${JSON.stringify(c.args)}`);
        });
        console.log('\nRun with --yolo to execute automatically');
        return content;
      }

      const results = await executeTools(toolCalls, { cwd, _provider: provider, _spawnDepth: 0, _skills: skills, _mcpClients: mcpClients });

      // Check if finish_task was among the results
      const finishResult = results.find(r => r.name === 'finish_task' && r.status === 'ok');
      if (finishResult) {
        return finishResult.text;
      }

      const toolOutput = results.map(r => r.text).join('\n');

      messages.push({
        role: 'user',
        content: `[TOOL RESULTS]\n${toolOutput}`
      });
      continue;
    }

    if (done || turn === CONFIG.maxTurns - 1) {
      return content;
    }
  }

  logger.error(`Max turns (${CONFIG.maxTurns}) reached without completion`);
  logger.error(`Model: ${provider.model} | Last response had ${lastToolCallCount} tool calls`);
  logger.error('Suggestions:');
  logger.error('  - Try a different model (mistral-small, qwen3-coder, deepseek-r1:32b work well)');
  logger.error(`  - Increase turns: --max-turns 10 (currently ${CONFIG.maxTurns})`);
  logger.error('  - Run with LOG_LEVEL=debug to see model responses');
  logger.error('  - Simplify the task or break it into smaller steps');
  throw new AppError('Max turns reached without completion');
  } finally {
    // Always tear down child MCP servers — success, failure, or hard throw.
    closeMcp();
  }
}

// ======== CLI INTERFACE ========
function parseArgs(argv) {
  const args = {
    task: '', model: '', provider: '', yolo: false, cwd: process.cwd(),
    openaiKey: '', anthropicKey: '', geminiKey: '', saveKeys: false,
    maxTurns: 0,
    allowHosts: [],
  };
  const positional = [];

  for (let i = 2; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === '--model' || arg === '-m') { args.model = argv[++i]; }
    else if (arg === '--provider' || arg === '-p') { args.provider = argv[++i]; }
    else if (arg === '--cwd') { args.cwd = argv[++i]; }
    else if (arg === '--yolo' || arg === '-y') { args.yolo = true; }
    else if (arg === '--max-turns') { args.maxTurns = parseInt(argv[++i] || '5', 10); }
    else if (arg === '--openai-key') { args.openaiKey = argv[++i]; }
    else if (arg === '--anthropic-key') { args.anthropicKey = argv[++i]; }
    else if (arg === '--gemini-key') { args.geminiKey = argv[++i]; }
    else if (arg === '--save-keys') { args.saveKeys = true; }
    else if (arg === '--allow-host') { args.allowHosts.push(argv[++i]); }
    else if (arg === '--help' || arg === '-h') { args.help = true; }
    else if (!arg.startsWith('-')) { positional.push(arg); }
    else { console.warn(`[WARN] Unknown flag ${arg} (ignored)`); }
  }

  args.task = positional.join(' ').trim();
  return args;
}

async function main() {
  try {
    const args = parseArgs(process.argv);
    // Load .env early so any provider base URLs or keys set there are visible
    loadDotEnvToProcess(args.cwd);

    // Fall back to defaultTask if no task provided on CLI
    if (!args.task && CONFIG.defaultTask) {
      args.task = CONFIG.defaultTask;
    }

    if (!args.task || args.help) {
      console.log(`
Simple Agent Runner

Usage:
  node agent.js "Your task here"
  node agent.js "Your task" --yolo                    # Auto-execute tools
  node agent.js --yolo                                # Run default task (if configured)
  node agent.js "Your task" --model deepseek-r1       # Choose Ollama model
  node agent.js "Your task" --cwd ./workspace         # Set working dir
  node agent.js "Your task" --max-turns 10            # Override max turns (default: 5)
  node agent.js "Your task" --provider openai -m gpt-5-mini  # Use OpenAI
  node agent.js "Your task" --provider anthropic -m claude-sonnet-4-5
  node agent.js "Your task" --provider gemini -m gemini-2.5-flash

Examples:
  node agent.js "Write a hello world program"
  node agent.js "Research topic X and create a report" --yolo
  node agent.js "Analyze this codebase" --cwd ./src
${CONFIG.defaultTask ? `\nDefault task: "${CONFIG.defaultTask}"\n  Run with just: node agent.js --yolo` : ''}
Models:
  Default: mistral-small (via Ollama)
  Ollama: mistral-small, mixtral, llama3.2, deepseek-r1, qwen2.5, codellama, etc.
  OpenAI: gpt-5, gpt-5-mini, gpt-5-nano, gpt-4.1 (requires OPENAI_API_KEY)
  Anthropic: claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-1 (requires ANTHROPIC_API_KEY)
  Gemini: gemini-2.5-pro, gemini-2.5-flash, gemini-2.0-flash (requires GEMINI_API_KEY)

TO CREATE YOUR AGENT:
1. Copy this file
2. Tell AI what kind of agent you want
3. AI will fill in the tools and customize the instructions
4. Run your new agent!
`);
      process.exit(0);
    }

    logger.info(`Starting agent with task: ${args.task}`);

    // Apply maxTurns override if provided
    if (args.maxTurns) {
      CONFIG.maxTurns = Math.max(1, args.maxTurns);
      logger.debug(`Overriding maxTurns to ${CONFIG.maxTurns}`);
    }

    // Extend networkAllowlist from env var + --allow-host flags (deduped).
    const envHosts = (process.env.AGENT_BUILDER_ALLOW_HOSTS || '')
      .split(',').map(s => s.trim()).filter(Boolean);
    const extraHosts = [...envHosts, ...args.allowHosts];
    if (extraHosts.length) {
      CONFIG.networkAllowlist = [...new Set([...CONFIG.networkAllowlist, ...extraHosts])];
      logger.debug(`Network allowlist: ${CONFIG.networkAllowlist.join(', ')}`);
    }

    const result = await runAgent(args);

    console.log('\n=== Agent Output ===');
    console.log(result);
    console.log('====================\n');

  } catch (error) {
    if (error instanceof AppError) {
      logger.error(`${error.code}: ${error.message}`);
      process.exit(error.exitCode);
    }
    logger.error('Unexpected error:', error.message);
    process.exit(2);
  }
}

if (require.main === module) {
  main();
}
