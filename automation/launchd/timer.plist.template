<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Interval timer — fires every __INTERVAL_SECONDS__ seconds while you are logged in.

  Install:
    1) Replace every __PLACEHOLDER__ in this file with real values.
    2) Copy to ~/Library/LaunchAgents/ee.agent-builder.__NAME__.plist
    3) launchctl load ~/Library/LaunchAgents/ee.agent-builder.__NAME__.plist
    4) Check: launchctl list | grep __NAME__

  Remove:
    launchctl unload ~/Library/LaunchAgents/ee.agent-builder.__NAME__.plist
    rm ~/Library/LaunchAgents/ee.agent-builder.__NAME__.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ee.agent-builder.__NAME__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ABS_PATH__/automation/invoke-agent.sh</string>
    <string>__AGENT_FILE__</string>
    <string>__TASK__</string>
    <string>--yolo</string>
  </array>

  <!-- Interval in seconds. Edit the integer below.
       60 = every minute, 300 = every 5 min, 3600 = hourly, 86400 = daily. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <!-- Set true if you want it to fire once immediately when the agent is loaded -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__REPO_ABS_PATH__/automation/logs/__NAME__.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ABS_PATH__/automation/logs/__NAME__.stderr.log</string>

  <!-- launchd starts with a minimal environment. Include the PATH your node/npx live on.
       Apple Silicon brew: /opt/homebrew/bin. Intel brew: /usr/local/bin. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Keep tasks light. If a run hangs, launchd throttle-restarts (min 10s between fires). -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
